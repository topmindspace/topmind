# Personal / machine-local AI tool configs at **repo root only**
# (do not use bare `opencode.json` — that would ignore skills/install-targets/opencode.json)
# Project contracts AGENTS.md / CLAUDE.md stay tracked.
.mcp.json
/opencode.json
.claude.json
.cursorrules
.cursorignore
*.code-workspace

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
venv/
.venv/

# Node & frontend build
node_modules/
dist/
dist-electron/
# Generic `build/` dirs — Desktop keeps committed packaging icons under
# topmind-desktop/build/ (icon.icns / icon.ico / icon.png / icons/*).
build/
!topmind-desktop/build/
!topmind-desktop/build/**
topmind-desktop/build/icon.iconset/
.turbo/
.next/
.nuxt/
*.tsbuildinfo
.npm
.eslintcache

# Accidental user-workspace material under Desktop package (never content truth in engine)
# cwd mis-open can seed empty {NN-}/ trees + topmind.yaml next to package.json
topmind-desktop/[0-9][0-9]-*/
topmind-desktop/memory/
topmind-desktop/topmind.yaml
topmind-desktop/.topmind/

# Desktop packaging / generated engine stage
topmind-desktop/release/
topmind-desktop/resources/
*.dmg
*.AppImage
*.exe
*.deb
*.snap
*.blockmap
latest*.yml
builder-effective-config.yaml
builder-debug.yml

# Pack / release outputs (also covered by dist/)
*.SHA256SUMS

# Local Homebrew cask snapshot (live tap is topmindspace/homebrew-tap)
casks/topmind.rb

