{
  "templateId": "academic",
  "version": "1.0.0",
  "name": "学术研究型",
  "description": "按笔记成熟度分类：闪念、文献、永久笔记、项目论文。适合学术研究/深度写作场景。",
  "categories": {
    "00": { "name": "收件箱", "role": "buffer", "required": true },
    "10": { "name": "闪念笔记", "role": "loose-stream", "specialBehavior": "flat-default" },
    "20": { "name": "文献笔记", "role": "deep-work" },
    "30": { "name": "永久笔记", "role": "deep-work" },
    "40": { "name": "索引结构", "role": "deep-work" },
    "50": { "name": "项目论文", "role": "deep-work" },
    "60": { "name": "参考文献", "role": "reference", "referenceOnly": true },
    "88": { "name": "输出", "role": "delivery", "required": true },
    "99": { "name": "归档", "role": "system", "required": true }
  },
  "connectorHints": {
    "weread": { "preferSlot": "20", "preferRole": "deep-work", "nameKeywords": ["文献", "阅读", "读书"] },
    "x": { "preferSlot": "60", "preferRole": "reference", "nameKeywords": ["参考", "social", "文献"] }
  },
  "stream": {
    "packing": "weekly",
    "appendHeading": "day"
  },
  "memory": {
    "dir": null,
    "profileFile": "我的情况.md"
  },
  "defaultViews": ["category", "tags", "graph"],
  "separator": "-"
}
