{
  "templateId": "knowledge-management",
  "version": "1.1.0",
  "name": "知识管理型",
  "description": "进阶：按内容性质分类（动态/研究/阅读/创作）。动态默认每周一本；比「简单工作台」多几个抽屉。",
  "categories": {
    "00": { "name": "收件箱", "role": "buffer", "required": true },
    "10": { "name": "动态", "role": "loose-stream", "specialBehavior": "flat-default" },
    "20": { "name": "研究", "role": "deep-work" },
    "30": { "name": "阅读", "role": "deep-work" },
    "40": { "name": "创作", "role": "deep-work" },
    "50": { "name": "其他", "role": "fallback", "catchAll": true, "retentionDays": 30 },
    "60": { "name": "参考资料", "role": "reference", "referenceOnly": true },
    "88": { "name": "输出", "role": "delivery", "required": true },
    "99": { "name": "归档", "role": "system", "required": true }
  },
  "stream": {
    "packing": "weekly",
    "appendHeading": "day"
  },
  "memory": {
    "dir": null,
    "profileFile": "我的情况.md"
  },
  "connectorHints": {
    "weread": { "preferSlot": "30", "preferRole": "deep-work", "nameKeywords": ["阅读", "读书", "read"] },
    "x": { "preferSlot": "60", "preferRole": "reference", "nameKeywords": ["参考", "social", "素材"] }
  },
  "defaultViews": ["category", "timeline"],
  "separator": "-"
}
