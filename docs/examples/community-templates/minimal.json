{
  "templateId": "minimal",
  "version": "1.0.0",
  "name": "极简型",
  "description": "最少分类：收件箱、笔记、输出、归档。适合喜欢简单结构的用户。",
  "categories": {
    "00": { "name": "收件箱", "role": "buffer", "required": true },
    "10": { "name": "笔记", "role": "loose-stream", "specialBehavior": "flat-default" },
    "88": { "name": "输出", "role": "delivery", "required": true },
    "99": { "name": "归档", "role": "system", "required": true }
  },
  "connectorHints": {
    "weread": { "preferSlot": "10", "preferRole": "loose-stream", "nameKeywords": ["Notes", "笔记", "阅读"] },
    "x": { "preferSlot": "10", "preferRole": "loose-stream", "nameKeywords": ["Notes", "笔记", "social"] }
  },
  "stream": {
    "packing": "weekly",
    "appendHeading": "day"
  },
  "memory": {
    "dir": null,
    "profileFile": "我的情况.md"
  },
  "defaultViews": ["category", "timeline"],
  "separator": "-"
}
