{
  "templateId": "project",
  "version": "1.0.0",
  "name": "项目管理型",
  "description": "按项目阶段分类：规划、执行中、监控评审、收尾、会议沟通。适合多项目追踪管理。",
  "categories": {
    "00": { "name": "收件箱", "role": "buffer", "required": true },
    "10": { "name": "规划", "role": "deep-work" },
    "20": { "name": "执行中", "role": "deep-work" },
    "30": { "name": "监控评审", "role": "deep-work" },
    "40": { "name": "收尾", "role": "deep-work" },
    "50": { "name": "会议沟通", "role": "loose-stream", "specialBehavior": "flat-default" },
    "60": { "name": "资源模板", "role": "reference", "referenceOnly": true },
    "88": { "name": "输出", "role": "delivery", "required": true },
    "99": { "name": "归档", "role": "system", "required": true }
  },
  "connectorHints": {
    "weread": { "preferSlot": "60", "preferRole": "reference", "nameKeywords": ["资源", "参考", "阅读"] },
    "x": { "preferSlot": "60", "preferRole": "reference", "nameKeywords": ["资源", "social", "素材"] }
  },
  "stream": {
    "packing": "weekly",
    "appendHeading": "day"
  },
  "memory": {
    "dir": null,
    "profileFile": "我的情况.md"
  },
  "defaultViews": ["category", "kanban", "timeline"],
  "separator": "-"
}
