{
  "schema_version": 1,
  "package": "topmind",
  "target": "opencode",
  "daily_entry": "topmind",
  "metadata": {
    "license": "MIT",
    "authors": [
      "TopMindSpace"
    ],
    "repository": "https://github.com/topmindspace/topmind",
    "homepage": "https://github.com/topmindspace/topmind#readme"
  },
  "skills": [
    "topmind",
    "topmind-capture",
    "topmind-organize",
    "topmind-write",
    "topmind-memory",
    "topmind-maintain",
    "topmind-loop",
    "topmind-weread",
    "topmind-x",
    "topmind-ledger"
  ],
  "install_strategy": "symlink-or-copy",
  "target_root_hint": "opencode-skills-root",
  "capabilities": [
    "skills",
    "mcp",
    "commands",
    "plugin"
  ],
  "content_truth": "topmind-workspace/categories-and-topics",
  "host_must_not": [
    "change-content-truth",
    "add-daily-entrypoints",
    "fork-skill-semantics",
    "persist-content-in-agent-state",
    "introduce-legacy-project-naming",
    "introduce-project_type-field"
  ],
  "config_shape": {
    "skills": {
      "paths": []
    },
    "mcp": {},
    "plugin": []
  },
  "notes": [
    "Use the host tool's discovered OpenCode config root.",
    "Expose the skill pack first; add MCP and plugin adapters only when the host environment enables them.",
    "Categories use 10-60/88/99 spaced number prefix (dynamic discovery); topics use YYYY-主题 kebab-case; do not introduce YYYY-类型-项目名.",
    "v4.3 progressive disclosure: name+description discovery; SKILL.md on activation; shared/ and references/ on demand. Single daily entry topmind."
  ],
  "install": {
    "script": "scripts/install-skills.mjs",
    "docs": "skills/INSTALL.md",
    "from_git": "node scripts/install-skills.mjs --from-git --host opencode",
    "from_release": "node scripts/install-skills.mjs --from-release latest --host opencode"
  }
}