  "metadata": {
    "license": "MIT",
    "authors": [
      {
        "name": "TopMindSpace",
        "github": "topmindspace"
      }
    ],
    "repository": "https://github.com/topmindspace/topmind",
    "homepage": "https://github.com/topmindspace/topmind#readme",
    "issues": "https://github.com/topmindspace/topmind/issues",
    "keywords": [
      "skill-pack",
      "personal-knowledge",
      "capture-first",
      "category-first",
      "topic-emerges",
      "file-system-truth",
      "agent-skills",
      "portable",
      "markdown-only",
      "anthropic-skills",
      "cursor-rules",
      "obsidian-friendly"
    ],
    "compatibility": {
      "hosts": [
        "opencode",
        "hermes",
        "codex",
        "claude-code",
        "mcp",
        "obsidian"
      ],
      "runtime": "pure-markdown",
      "optional_dependencies": {
        "utr": "node >= 18, optional deterministic CLI/MCP commands",
        "desktop": "Electron, optional GUI client (topmind-desktop/)"
      }
    },
    "content_schema": {
      "_disambiguation_note": "The frontmatter `action_category` key refers to the action-skill taxonomy (capture|organize|write|memory|maintain|loop|router|connector). User note frontmatter has a `category` field, but there it means the physical category directory name (e.g. template-defined name like research category). Different keys, different meanings — no collision.",
      "frontmatter_required_fields": [
        "name",
        "version",
        "description",
        "action_category",
        "triggers"
      ],
      "frontmatter_optional_fields": [
        "tags",
        "entrypoint",
        "degradation",
        "author",
        "license",
        "homepage",
        "updated",
        "compatibility"
      ],
      "frontmatter_description_rules": [
        "max 1024 characters (Agent Skills open standard)",
        "structure: what it does + Use when (zh/en phrases) + Do NOT use (negative boundary)",
        "include when-to-use triggers (zh/en phrases users actually say)",
        "include when-not-to-use boundaries to reduce false activation",
        "description is the progressive-disclosure discovery signal",
        "sub-skills must not use over-broad phrasing that steals sibling activation",
        "router prefers multi-intent/ambiguous; single clear verbs prefer action skills"
      ],
      "progressive_disclosure": {
        "discovery": "name + description only (~100 tokens/skill)",
        "activation": "full SKILL.md body when matched",
        "resources": "shared/*.md and skill references/* loaded on demand",
        "host_loading": "skills/shared/host-loading.md",
        "shared_must_be_sibling": "install shared/ next to skill dirs so ../shared/ resolves"
      },
      "frontmatter_action_categories": [
        "capture",
        "organize",
        "write",
        "memory",
        "maintain",
        "loop",
        "router",
        "connector"
      ]
    }
  },
  "entry_files": [
    "topmind/SKILL.md",
    "topmind-capture/SKILL.md",
    "topmind-organize/SKILL.md",
    "topmind-write/SKILL.md",
    "topmind-memory/SKILL.md",
    "topmind-maintain/SKILL.md",
    "topmind-loop/SKILL.md",
    "topmind-weread/SKILL.md",
    "topmind-x/SKILL.md"
  ],
