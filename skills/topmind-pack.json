  "product_contract": {
    "capture_first": true,
    "category_first": true,
    "topic_emerges": true,
    "action_first": true,
    "single_user_entry": true,
    "content_truth": "topmind-workspace/categories-and-topics",
    "inbox_role": "unassigned-capture",
    "topic_role": "assigned-work",
    "loose_note_role": "unfiled-but-categorized"
  },
  "category_slots": {
    "_mode": "template-driven-dynamic-discovery",
    "_templates": [
      "stream",
      "balanced",
      "research",
      "periodic"
    ],
    "_default_template": "stream",
    "_note": "默认 stream（收件箱+动态+输出+归档）。topmind.yaml contract v4 含 stream.packing / memory.layers。解析 lib/workspace-model.mjs + stream-period.mjs。"
  },
  "category_roles": [
    "buffer",
    "loose-stream",
    "deep-work",
    "fallback",
    "reference",
    "delivery",
    "system"
  ],
  "category_rules": [
    "dynamic_discovery: {NN}[- ]{Name}/ 自发现；属性 overrides > extensions > template > deep-work",
    "config_v4: categories.extensions 用户扩展类；categories.overrides 含 hidden；contract_version 4",
    "workspace_model: Skills/UTR/Desktop 同一语义；list-categories 返回 CategoryDescriptor",
    "no_overlap: 同一内容/主题只能在一个大类下，按内容性质判定",
    "stream_packing: stream.packing=weekly|daily|monthly|atom；默认 weekly 周期本 append",
    "core_memory: memory.dir + profileFile（默认 profile.md）可配置记忆目录",
    "topic_emerges: 默认不建专题；反复出现时建议升专题",
    "template_flat_default: specialBehavior='flat-default' 的类别默认平铺（持续流），强主题才专题化",
    "template_catch_all: catchAll=true 的类别每 retentionDays 天清理一次（默认 30）",
    "template_reference_only: referenceOnly=true 的类别只放反复引用的素材",
    "category_naming_stable: 大类名不轻易改；改走 renameCategory（目录+frontmatter+config）",
    "hidden_categories: overrides.hidden 侧栏/索引/connector 默认跳过，不删盘",
    "spaced_numbering: 10/20/30/40/50/60 间隔便于插入自定义槽位",
    "connector_hints: 模板 connectorHints；可被 connectorDefaults 覆盖"
  ],
  "topic_naming": {
    "format": "YYYY-主题",
    "style": "kebab-case",
    "project_id_field_renamed_to": "topic",
    "deprecated_field": "project_type"
  },
  "writeback_modes": [
    "auto",
    "confirm"
  ],
  "surfaces": [
    "codex",
    "hermes",
    "opencode",
    "desktop",
    "mcp",
    "obsidian"
  ],
  "portable_contract": {
    "requires_desktop": false,
    "requires_utr": false,
    "content_truth": "topmind-workspace/categories-and-topics",
    "host_may_provide": [
