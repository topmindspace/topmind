{
  "schema_version": 1,
  "kind": "workspace-transform",
  "skill": "workspace-transform",
  "label": "工作区转换工具",
  "description": "工作区转换：Inbox 路由规划、metadata 归一、一次性迁移（扩展命令）。",
  "execution": {
    "runtime": "node",
    "cwd_mode": "engine_root",
    "script": "utr/tools/workspace-transform.mjs",
    "args_template": [
      "--categories-root",
      "{categories_root}",
      "--inbox-root",
      "{inbox_root}",
      "--archive-root",
      "{archive_root}",
      "--format",
      "json",
      "{command}"
    ]
  },
  "commands": {
    "normalize-note-metadata": {
      "label": "规范化 note metadata",
      "description": "批量预览并归一化笔记的 status、topic、category 等 metadata。检测到 `project_type` 字段时从 frontmatter 中移除。",
      "group": "maintenance",
      "exposure": "advanced",
      "risk_level": "medium",
      "review_policy": "preview_or_auto",
      "requires_topic": false,
      "idempotent": true,
      "supports_dry_run": true,
      "destructive": false,
      "inputs": {
        "dryRun": {
          "type": "toggle",
          "label": "仅预览",
          "default": true
        }
      },
      "args_extra": [
        "--mode",
        "{mode}"
      ],
      "reads": [
        "{category}/{topic}/**",
        "00-收件箱/**"
      ],
      "writes": [
        "{category}/{topic}/**",
        "00-收件箱/**"
      ]
    },
    "plan-inbox-routing": {
      "label": "规划 inbox 路由",
      "description": "读取 00 收件箱 文件并生成建议路由到各大类的方案；不写入。",
      "group": "assistive",
      "exposure": "primary",
      "risk_level": "low",
      "review_policy": "auto",
      "requires_topic": false,
      "idempotent": true,
      "supports_dry_run": false,
      "destructive": false,
      "inputs": {
        "limit": {
          "type": "number",
          "label": "最大数量",
          "default": 50,
          "min": 1,
          "max": 200
        }
      },
      "args_extra": [
        "--limit",
        "{limit}"
      ],
      "reads": [
        "00-收件箱/**",
        "{category}/{topic}/topic.md"
      ],
      "writes": []
    },
    "migrate-v4": {
      "label": "迁移到 v4",
      "description": "一次性迁移：config v3 JSON → topmind.yaml、旧专题首页 → topic.md、我的情况.md → memory/profile.md、.loop/ → .topmind/loop/、99-归档/receipts → 保留、state.json → 删除或重建到各大类 .derived/。",
      "group": "maintenance",
      "exposure": "advanced",
      "risk_level": "high",
      "review_policy": "preview_or_auto",
      "requires_topic": false,
      "idempotent": false,
      "supports_dry_run": true,
      "destructive": true,
      "inputs": {
        "dryRun": {
          "type": "toggle",
          "label": "仅预览",
          "default": true
        },
        "writebackMode": {
          "type": "select",
          "label": "保存设置",
          "default": "confirm",
          "options": [
            {
              "value": "auto",
              "label": "自动迁移（高风险）"
            },
            {
              "value": "confirm",
              "label": "需要审阅（推荐）"
            }
          ]
        }
      },
      "args_extra": [
        "--mode",
        "{mode}"
      ],
      "reads": [
        ".topmind-config.json",
        "**/project.md",
        "**/我的情况.md",
        ".loop/**",
        "**/state.json"
      ],
      "writes": [
        "topmind.yaml",
        "**/topic.md",
        "memory/profile.md",
        ".topmind/loop/**",
        "**/.derived/**"
      ],
      "workflow_note": "One-shot v3 → v4 migration. Reads from .topmind-config.json (legacy), writes to topmind.yaml (v4), renames project.md → topic.md, moves 我的情况.md → memory/profile.md, moves .loop/ → .topmind/loop/, deletes or rebuilds state.json to .derived/. Returns a migration receipt listing every moved path."
    }
  }
}