{
  "name": "topmind-desktop",
  "version": "4.13.0",
  "private": true,
  "description": "topmind local-first desktop workspace for AI-assisted project work.",
  "main": "electron/main.mjs",
  "type": "module",
  "license": "MIT",
  "author": "TopMindSpace",
  "repository": {
    "type": "git",
    "url": "https://github.com/topmindspace/topmind.git",
    "directory": "topmind-desktop"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev-desktop.mjs",
    "dev:renderer": "node scripts/dev-renderer.mjs",
    "dev:electron": "node scripts/dev-electron.mjs",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "deps:policy": "node scripts/check-dependency-policy.mjs",
    "deps:packaging": "node scripts/check-packaging-deps.mjs",
    "icons:generate": "python3 scripts/generate-icons.py",
    "icons:patch-electron": "node scripts/patch-electron-icon.mjs",
    "icons:restore-electron": "node scripts/patch-electron-icon.mjs --restore",
    "postinstall": "node scripts/patch-electron-icon.mjs || true",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:electron": "node scripts/check-electron.mjs",
    "check:undeclared": "node scripts/check-undeclared-idents.mjs",
    "check:dead-code": "node scripts/check-dead-code.mjs",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "test": "tsx --test --test-force-exit tests/*.test.mjs && tsx --test --test-force-exit tests/*.test.ts",
    "build": "vite build",
    "build:report": "node scripts/report-build.mjs",
    "pack:prepare": "npm run deps:packaging && node scripts/prepare-engine-resources.mjs",
    "pack:verify": "node scripts/verify-pack.mjs",
    "pack:verify:strict": "node scripts/verify-pack.mjs --require-artifacts",
    "pack:dir": "npm run build && npm run pack:prepare && node scripts/electron-builder-ci.mjs dir host && npm run pack:verify",
    "pack:mac": "npm run build && npm run pack:prepare && node scripts/electron-builder-ci.mjs mac host && npm run pack:verify",
    "pack:linux": "npm run build && npm run pack:prepare && node scripts/electron-builder-ci.mjs linux host && npm run pack:verify",
    "pack:linux:arm64": "npm run build && npm run pack:prepare && node scripts/electron-builder-ci.mjs linux arm64 && npm run pack:verify",
    "pack:win": "npm run build && npm run pack:prepare && node scripts/electron-builder-ci.mjs win host && npm run pack:verify",
    "pack:mac:ci": "npm run build && npm run pack:prepare && node scripts/electron-builder-ci.mjs mac host && npm run pack:verify:strict",
    "pack:linux:ci": "npm run build && npm run pack:prepare && node scripts/electron-builder-ci.mjs linux host && npm run pack:verify:strict",
    "pack:win:ci": "npm run build && npm run pack:prepare && node scripts/electron-builder-ci.mjs win host && npm run pack:verify:strict",
    "validate": "npm run deps:packaging && npm run typecheck && npm run check:electron && npm run check:undeclared && npm run check:dead-code && npm run check:i18n && npm run test && npm run build && npm run build:report && npm run pack:prepare && npm run pack:verify",
    "check:quality": "npm run validate",
    "start": "electron ."
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.60",
    "@ai-sdk/google": "^4.0.77",
    "@ai-sdk/openai": "^4.0.72",
    "@ai-sdk/openai-compatible": "^3.0.53",
    "@dnd-kit/core": "^6.3.1",
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@remixicon/react": "^4.9.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-character-count": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-typography": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "ai": "^7.0.111",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "js-yaml": "^4.3.2",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.13",
    "mailparser": "^3.9.26",
    "mammoth": "^1.12.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.14",
    "tiptap-markdown": "^0.9.0",
    "typebox": "^1.3.30",
    "unpdf": "^1.8.1",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.4.4",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
