# Project npm config — only keys npm understands.
# Electron download mirrors are NOT npm config keys (npm 10+ warns / future hard-fail).
# Set mirrors via environment when needed (e.g. CN network):
#   export ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
#   export ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/
#
# GitHub Actions should use official downloads (no mirror env).
